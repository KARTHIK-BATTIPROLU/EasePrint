      "parameters": {
        "jsCode": "const out = [];\nconst jobItems = $('Prepare Job').all();\nconst inItems = $input.all();\nfor (let i = 0; i < inItems.length; i++) {\n  const job = ((jobItems[i] && jobItems[i].json) || (jobItems[0] && jobItems[0].json) || {});\n  const cur = inItems[i].json || {};\n  let fileS3Url = '';\n  if (cur.Location) fileS3Url = cur.Location;\n  else if (cur.Key) fileS3Url = 'https://easeprint-documents-601548053760-us-east-1-an.s3.amazonaws.com/' + cur.Key;\n  else if (job.file_s3_url) fileS3Url = job.file_s3_url;\n  out.push({ json: {\n    job_id: job.job_id,\n    source_channel: job.source_channel,\n    sender_id: job.sender_id,\n    sender_name: job.sender_name || 'Anonymous',\n    status: 'received',\n    message_text: job.message_text || '',\n    file_s3_url: fileS3Url,\n    created_at: new Date().toISOString(),\n  } });\n}\nreturn out;"

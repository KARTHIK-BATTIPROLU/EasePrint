    {
      "parameters": {
        "description": "Calculate the exact Hyderabad Xerox/print price in INR. Provide pages (int), copies (int), color_mode (\"color\" or \"bw\"), sides (\"single\" or \"double\"), binding (\"none\"|\"spiral\"|\"soft\"|\"hard\").",
        "jsCode": "let input = query;\nif (typeof input === 'string') {\n  try { input = JSON.parse(input); } catch (e) { input = {}; }\n}\nconst pages = parseInt(input.pages, 10) || 1;\nconst copies = parseInt(input.copies, 10) || 1;\nconst colorMode = (input.color_mode || 'bw').toLowerCase();\nconst sides = (input.sides || 'single').toLowerCase();\nconst binding = (input.binding || 'none').toLowerCase();\n\nlet perPage;\nif (colorMode === 'color') {\n  perPage = 10;\n} else if (sides === 'double') {\n  perPage = 1.5;\n} else {\n  perPage = 2;\n}\nconst pagesCost = pages * perPage;\n\nconst bindingRates = { none: 0, staple: 0, spiral: 30, soft: 50, hard: 180 };\nconst bindingCost = (bindingRates[binding] !== undefined ? bindingRates[binding] : 0);\n\nconst perCopy = pagesCost + bindingCost;\nconst total = perCopy * copies;\n\nconst breakdown = {\n  pages: pages,\n  copies: copies,\n  color_mode: colorMode,\n  sides: sides,\n  binding: binding,\n  per_page_rate_inr: perPage,\n  pages_cost_inr: pagesCost,\n  binding_cost_inr: bindingCost,\n  per_copy_inr: perCopy,\n};\n\nreturn JSON.stringify({ currency: 'INR', total_price: total, breakdown: breakdown });",
        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"pages\":{\"type\":\"integer\"},\"copies\":{\"type\":\"integer\"},\"color_mode\":{\"type\":\"string\",\"enum\":[\"color\",\"bw\"]},\"sides\":{\"type\":\"string\",\"enum\":[\"single\",\"double\"]},\"binding\":{\"type\":\"string\",\"enum\":[\"none\",\"staple\",\"spiral\",\"soft\",\"hard\"]}},\"required\":[\"pages\",\"copies\",\"color_mode\",\"sides\",\"binding\"]}"
      },

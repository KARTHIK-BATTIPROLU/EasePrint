        "jsCode": "const out = [];\nconst exItems = $('Extract WhatsApp').all();\nconst inItems = $input.all();\nfor (let i = 0; i < inItems.length; i++) {\n  const ex = ((exItems[i] && exItems[i].json) || (exItems[0] && exItems[0].json) || {});\n  const item = inItems[i];\n  const hasFile = !!(item.binary && item.binary.data);\n  out.push({ json: {\n    source_channel: 'whatsapp',\n    sender_id: ex.sender_id,\n    sender_name: ex.sender_name || 'Anonymous',\n    message_text: ex.message_text || '',\n    has_file: hasFile,\n    file_name: hasFile ? (ex.file_name || 'uploaded_file.pdf') : null,\n    received_at: new Date().toISOString(),\n  }, binary: item.binary });\n}\nreturn out;"

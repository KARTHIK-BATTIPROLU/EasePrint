# Redis connection URL
REDIS_URL=redis://redis:6379/0

# Anthropic Claude API configuration
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-4-6

# AWS & DynamoDB configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=EasePrintJobs
# Use endpoint URL for local DynamoDB (e.g. within Docker or LocalStack)
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000

# n8n Webhook for sending clarifying questions back to user channel
N8N_CALLBACK_URL=http://host.docker.internal:5678/webhook/print-clarifications

# Worker Concurrency
MAX_JOBS=10
